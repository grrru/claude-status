def load_usage_module():
    """같은 폴더의 claude-usage를 모듈로 읽는다 (API·자격증명은 그쪽에만 있다)"""
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    sys.dont_write_bytecode = True
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, 'claude-usage'), os.path.expanduser('~/.local/bin/claude-usage')):
        if os.path.exists(path):
            loader = SourceFileLoader('claude_usage', path)
            module = module_from_spec(spec_from_loader('claude_usage', loader))
            loader.exec_module(module)
            return module
    return None

try:
    usage_api = load_usage_module()
except Exception:
    usage_api = None

def dig(d, *keys):
    for key in keys:
        if not isinstance(d, dict):
            return None
        d = d.get(key)
    return d

def paint(color, text):
    return f'{color}{text}{RESET}' if text else ''

def link(url, text):
    return f'\033]8;;{url}\033\\{text}\033]8;;\033\\' if url else text

def short_dir(path):
    parts = path.split('/')
    return '/'.join(parts[-2:]) if len(parts) > 2 else path

def fmt_tokens(n):
    if n >= 1_000_000:
        return f'{n / 1_000_000:.1f}M'
    if n >= 1000:
        return f'{n / 1000:.0f}k'
    return str(n)

def fmt_duration(seconds):
    seconds = max(0, int(seconds))
    days, rest = divmod(seconds, 86400)
    hours, rest = divmod(rest, 3600)
    minutes, secs = divmod(rest, 60)
    if days:
        return f'{days}d{hours}h'
    if hours:
        return f'{hours}h{minutes}m'
    if minutes:
        return f'{minutes}m'
    return f'{secs}s'

def read_git(cwd, with_status):
    """(branch, dirty, ahead, behind) — git 저장소가 아니면 ()"""
    env = dict(os.environ, GIT_OPTIONAL_LOCKS='0')
    def git(*args):
        return subprocess.run(['git', *args], cwd=cwd, env=env, capture_output=True, text=True, timeout=2)
    try:
        if not with_status:
            r = git('rev-parse', '--abbrev-ref', 'HEAD')
            return (r.stdout.strip(), False, 0, 0) if r.returncode == 0 else ()
        r = git('status', '--porcelain=v2', '--branch')
    except (OSError, subprocess.SubprocessError):
        return ()
    if r.returncode != 0:
        return ()
    branch, dirty, ahead, behind = '', False, 0, 0
    for line in r.stdout.splitlines():
        if line.startswith('# branch.head '):
            branch = line.split(' ', 2)[2]
            if branch == '(detached)':
                branch = 'HEAD'
        elif line.startswith('# branch.ab '):
            a, b = line.split()[2:4]
            ahead, behind = int(a), -int(b)
        elif not line.startswith('#'):
            dirty = True
    return (branch, dirty, ahead, behind)

class Status:
    def __init__(self, payload, plan, elements, usage=None, cwd=None, git=None):
        self.p = payload
        self.plan = plan
        self.elements = elements
        self.usage = usage      # claude-usage 캐시 (OAuth usage API 응답)
        self.cwd = cwd or payload_dir(payload)
        self._git = git

    def render(self):
        segments = []
        for key in self.elements:
            try:
                segments.append(getattr(self, 'el_' + key)())
            except Exception:
                pass
        return ' '.join(s for s in segments if s)

    def git(self):
        if self._git is None:
            self._git = read_git(self.cwd, 'git_status' in self.elements)
        return self._git

    def percent_used(self):
        size = dig(self.p, 'context_window', 'context_window_size')
        current = dig(self.p, 'context_window', 'current_usage')
        if not size or not isinstance(current, dict):
            return None
        tokens = sum(current.get(k) or 0 for k in ('input_tokens', 'cache_creation_input_tokens', 'cache_read_input_tokens'))
        return tokens * 100 // size if tokens > 0 else None

    def el_dir(self):
        return paint(C_DIR, short_dir(self.cwd))

    def el_git(self):
        g = self.git()
        return paint(C_GIT_BRANCH, BRANCH_ICON + g[0]) if g and g[0] else ''

    def el_git_status(self):
        g = self.git()
        if not g:
            return ''
        _, dirty, ahead, behind = g
        return paint(C_GIT_STATUS, ('*' if dirty else '') + (f'↑{ahead}' if ahead else '') + (f'↓{behind}' if behind else ''))

    def el_pr(self):
        pr = self.p.get('pr') or {}
        if not pr.get('number'):
            return ''
        label = f"MR!{pr['number']}" if pr.get('kind') == 'mr' else f"PR#{pr['number']}"
        mark = REVIEW_MARKS.get(pr.get('review_state'))
        return paint(C_PR, link(pr.get('url'), f'{label} {mark}' if mark else label))

    def el_model(self):
        raw = dig(self.p, 'model', 'display_name') or dig(self.p, 'model', 'id') or ''
        if not raw:
            return ''
        lower = raw.lower()
        if 'haiku' in lower:
            icon = HAIKU_NERD
        elif 'sonnet' in lower:
            icon = SONNET_NERD
        elif 'opus' in lower:
            icon = OPUS_NERD
        else:
            icon = SONNET_NERD
        return paint(C_MODEL, icon + lower)

    def el_effort(self):
        level = dig(self.p, 'effort', 'level')
        return paint(C_EFFORT, f"{EFFORT_MARKS.get(level, '◐')} {level}") if level else ''

    def el_thinking(self):
        return paint(C_THINKING, '✻ think') if dig(self.p, 'thinking', 'enabled') is True else ''

    def el_output_style(self):
        name = dig(self.p, 'output_style', 'name') or ''
        return paint(C_STYLE, f'✎ {name.lower()}') if name and name.lower() != 'default' else ''

    def el_version(self):
        version = self.p.get('version')
        return paint(C_DIM, f'v{version}') if version else ''

    def el_context(self):
        pct = self.percent_used()
        return paint(C_CONTEXT, f'{pct}%'.rjust(3) if pct is not None else '~~%')

    def el_context_tokens(self):
        size = dig(self.p, 'context_window', 'context_window_size')
        used = dig(self.p, 'context_window', 'total_input_tokens')
        return paint(C_CONTEXT, f'{fmt_tokens(used)}/{fmt_tokens(size)}') if size and used is not None else ''

    def el_context_bar(self):
        pct = self.percent_used()
        if pct is None:
            return ''
        filled = min(10, (pct + 5) // 10)
        color = C_RED if pct >= PROGRESS_RED else C_YELLOW if pct >= PROGRESS_YELLOW else C_GREEN
        return paint(color, '█' * filled + '░' * (10 - filled))

    def el_cache(self):
        cache = self.p.get('prompt_cache') or {}
        if not cache.get('caching_observed'):
            return ''
        if cache.get('warm') is False:
            return paint(C_RED, 'cache cold')
        parts = ['cache']
        if cache.get('hit_ratio') is not None:
            parts.append(f"{cache['hit_ratio'] * 100:.0f}%")
        if cache.get('ttl'):
            parts.append(cache['ttl'])
        return paint(C_EFFORT, ' '.join(parts))

    def el_cost(self):
        cost = dig(self.p, 'cost', 'total_cost_usd')
        return paint(C_GREEN, f'${cost:.2f}') if cost else ''

    def el_lines(self):
        added = dig(self.p, 'cost', 'total_lines_added') or 0
        removed = dig(self.p, 'cost', 'total_lines_removed') or 0
        if not (added or removed):
            return ''
        return f'{paint(C_GREEN, f"+{added}")} {paint(C_RED, f"-{removed}")}'

    def el_duration(self):
        ms = dig(self.p, 'cost', 'total_duration_ms')
        return paint(C_DIM, f'◷ {fmt_duration(ms / 1000)}') if ms else ''

    def el_plan(self):
        if self.plan == 'enterprise':
            return paint(C_PLAN, 'Enterprise')
        sub = (self.usage or {}).get('subscription_type')
        return paint(C_PLAN, sub.title() if sub else 'Subscription')

    def el_usage(self):
        if usage_api is None:
            return ''
        return paint(C_USAGE, usage_api.format_usage(self.usage, self.plan, self.p.get('rate_limits')))

    def el_reset(self):
        if usage_api is None:
            return ''
        now = time.time()
        windows = usage_api.subscription_windows(self.usage, self.p.get('rate_limits'))
        return paint(C_PR, ' '.join(f'{label}↻{fmt_duration(at - now)}' for label, _, at in windows if at and at > now))

    def el_credits(self):
        credits = usage_api.monthly_credits(self.usage) if usage_api else None
        if credits is None:
            return ''
        used, limit, _ = credits
        return paint(C_USAGE, f'rem ${max(0, limit - used):.0f}')

def payload_dir(payload):
    d = dig(payload, 'workspace', 'current_dir') or dig(payload, 'workspace', 'project_dir') or payload.get('cwd') or ''
    if d and os.path.isdir(d):
        return d
    return os.environ.get('PWD') or os.getcwd()

def load_config():
    try:
        with open(CONFIG_FILE) as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except Exception:
        return {}

def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    tmp = CONFIG_FILE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write('\n')
    os.replace(tmp, CONFIG_FILE)

def available(plan):
    return [key for key, _, plans in ELEMENTS if plan in plans]

def enabled_elements(cfg, plan):
    chosen = dig(cfg, 'elements', plan)
    if not isinstance(chosen, list):
        chosen = DEFAULTS[plan]
    return [key for key in available(plan) if key in chosen]

def resolve_plan(cfg, usage, rate_limits=None):
    plan = cfg.get('plan', 'auto')
    if plan in PLANS:
        return plan
    return usage_api.detect_plan(usage, rate_limits) if usage_api else 'subscription'

def needs_api(plan, elements, rate_limits):
    """캐시가 오래됐을 때 API를 다시 부를 만한 요소가 켜져 있는지"""
    if usage_api is None:
        return False
    if plan == 'enterprise':
        return bool({'usage', 'credits'} & set(elements))
    # 구독 플랜은 statusLine 입력의 rate_limits에 5h/7d가 실시간으로 들어온다
    return bool({'usage', 'reset'} & set(elements)) and not usage_api.has_windows(None, rate_limits)

def build_status(payload, cfg):
    rate_limits = payload.get('rate_limits')
    usage = usage_api.load_cache() if usage_api else None
    plan = resolve_plan(cfg, usage, rate_limits)
    elements = enabled_elements(cfg, plan)
    if needs_api(plan, elements, rate_limits):
        usage = usage_api.get_usage()
        plan = resolve_plan(cfg, usage, rate_limits)
        elements = enabled_elements(cfg, plan)
    return Status(payload, plan, elements, usage)

def emit_progress(percent_used):
    """OSC 9;4 progress bar"""
    if percent_used is None:
        return
    progress_percent = 100 if percent_used >= PROGRESS_COMPACT else percent_used * 100 // PROGRESS_COMPACT
    if percent_used >= PROGRESS_RED:
        progress_state = 2
    elif percent_used >= PROGRESS_YELLOW:
        progress_state = 4
    else:
        progress_state = 1
    try:
        with open('/dev/tty', 'w') as tty:
            tty.write(f'\033]9;4;{progress_state};{progress_percent}\a')
    except OSError:
        pass

