def plain(text):
    import re
    return re.sub(r'\033\]8;;.*?\033\\|\033\[[0-9;]*m', '', text)

def width(text):
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(c) in 'WF' else 1 for c in text)

def pad(text, cols):
    return text + ' ' * max(0, cols - width(text))

def clip(text, cols):
    out, used = '', 0
    for c in text:
        w = width(c)
        if used + w > cols:
            break
        out += c
        used += w
    return out

def example(key, plan):
    if plan not in dict((k, p) for k, _, p in ELEMENTS)[key]:
        plan = next(p for p in PLANS if p != plan)
    return plain(mock_status(plan, [key]).render())

def describe_plan(cfg):
    usage = usage_api.load_cache() if usage_api else None
    plan = resolve_plan(cfg, usage)
    if cfg.get('plan', 'auto') in PLANS:
        return plan, f'{PLAN_NAMES[plan]} (고정)'
    sub = (usage or {}).get('subscription_type')
    return plan, f"{PLAN_NAMES[plan]} (자동 감지{': ' + sub if sub else ''})"

def print_list(cfg):
    plan, desc = describe_plan(cfg)
    on = {p: set(enabled_elements(cfg, p)) for p in PLANS}
    print(f'현재 플랜  {desc}')
    print(f'설정 파일  {CONFIG_FILE}\n')
    print(f"{pad('요소', 16)}{pad('구독', 6)}{pad('Ent', 6)}{pad('설명', 46)}예시")
    for key, desc, plans in ELEMENTS:
        marks = ''.join(pad(('✔' if key in on[p] else '·') if p in plans else '-', 6) for p in PLANS)
        print(f'{pad(key, 16)}{marks}{pad(desc, 46)}{example(key, plan)}')
    progress = '✔' if cfg.get('progress', True) else '·'
    print(f"{pad('progress', 16)}{pad(progress, 6)}{pad(progress, 6)}{PROGRESS_DESC}")

def edit_elements(cfg, plan, keys, turn_on):
    keys = list(dict.fromkeys(keys))
    if 'progress' in keys:
        cfg['progress'] = turn_on
        keys.remove('progress')
    unknown = [k for k in keys if k not in [key for key, _, _ in ELEMENTS]]
    if unknown:
        sys.exit(f"없는 요소: {', '.join(unknown)}  (목록: claude-status --list)")
    other_plan = [k for k in keys if k not in available(plan)]
    if other_plan:
        sys.exit(f"{PLAN_NAMES[plan]}에서는 쓸 수 없는 요소: {', '.join(other_plan)}  (대상 플랜은 --plan 으로 지정)")
    if keys:
        chosen = set(enabled_elements(cfg, plan))
        chosen = chosen | set(keys) if turn_on else chosen - set(keys)
        cfg.setdefault('elements', {})[plan] = [k for k in available(plan) if k in chosen]
    save_config(cfg)
    print(f"{PLAN_NAMES[plan]}: {' '.join(enabled_elements(cfg, plan))}")

def print_preview(cfg, plans):
    for plan in plans:
        print(f'{pad(PLAN_NAMES[plan], 20)}{mock_status(plan, enabled_elements(cfg, plan)).render()}')

def run_config_ui(cfg):
    import curses, locale
    locale.setlocale(locale.LC_ALL, '')
    current, _ = describe_plan(cfg)
    chosen = {p: set(enabled_elements(cfg, p)) for p in PLANS}
    ui = {'tab': PLANS.index(current), 'row': 0, 'top': 0,
          'plan': cfg.get('plan', 'auto'), 'progress': cfg.get('progress', True)}
    plan_modes = ('auto',) + PLANS

    def rows():
        return available(PLANS[ui['tab']]) + ['progress']

    def put(scr, y, x, text, attr=0):
        h, w = scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                scr.addstr(y, x, clip(text, w - x - 1), attr)
            except curses.error:
                pass

    def draw(scr):
        scr.erase()
        h, w = scr.getmaxyx()
        plan = PLANS[ui['tab']]
        put(scr, 0, 1, 'claude-status 설정', curses.A_BOLD)
        x = 1
        for i, p in enumerate(PLANS):
            label = f' {PLAN_NAMES[p]} '
            put(scr, 2, x, label, curses.A_REVERSE if i == ui['tab'] else curses.A_DIM)
            x += width(label) + 2
        put(scr, 2, x + 2, '← → 플랜 전환', curses.A_DIM)

        items = rows()
        list_h = max(3, h - 10)
        ui['top'] = min(max(ui['top'], ui['row'] - list_h + 1), ui['row'])
        descs = dict((k, d) for k, d, _ in ELEMENTS)
        for line, key in enumerate(items[ui['top']:ui['top'] + list_h]):
            i = ui['top'] + line
            is_on = ui['progress'] if key == 'progress' else key in chosen[plan]
            text = f"{'▸' if i == ui['row'] else ' '} [{'x' if is_on else ' '}] {pad(key, 15)}{pad(descs.get(key, PROGRESS_DESC), 44)}"
            if key != 'progress':
                text += example(key, plan)
            put(scr, 4 + line, 1, text, curses.A_BOLD if i == ui['row'] else 0)

        y = 5 + list_h
        preview = plain(mock_status(plan, [k for k in available(plan) if k in chosen[plan]]).render())
        put(scr, y, 1, '미리보기  ', curses.A_DIM)
        put(scr, y, 11, preview)
        mode = ui['plan']
        detect = f'{PLAN_NAMES[mode]}로 고정' if mode in PLANS else f'자동 (지금은 {PLAN_NAMES[current]})'
        put(scr, y + 1, 1, '플랜 감지  ', curses.A_DIM)
        put(scr, y + 1, 11, f'{detect}    p 바꾸기')
        put(scr, y + 3, 1, '↑↓ 이동 · Space 켜기/끄기 · ←→ 플랜 · d 기본값 · Enter 저장 · q 취소', curses.A_DIM)
        scr.refresh()

    arrows = {ord('A'): curses.KEY_UP, ord('B'): curses.KEY_DOWN, ord('C'): curses.KEY_RIGHT, ord('D'): curses.KEY_LEFT}

    def read_key(scr):
        key = scr.getch()
        if key != 27:
            return key
        # keypad가 못 알아본 화살표(ESC [ C 등)는 직접 해석하고, ESC만 오면 취소
        scr.nodelay(True)
        try:
            seq = [scr.getch(), scr.getch()]
        finally:
            scr.nodelay(False)
        if seq[0] in (ord('['), ord('O')) and seq[1] in arrows:
            return arrows[seq[1]]
        return 27

    def loop(scr):
        try:
            curses.curs_set(0)
            curses.use_default_colors()   # 터미널 테마 배경을 그대로 쓴다
        except curses.error:
            pass
        if hasattr(curses, 'set_escdelay'):
            curses.set_escdelay(25)
        while True:
            draw(scr)
            key = read_key(scr)
            items = rows()
            plan = PLANS[ui['tab']]
            if key in (curses.KEY_UP, ord('k')):
                ui['row'] = (ui['row'] - 1) % len(items)
            elif key in (curses.KEY_DOWN, ord('j')):
                ui['row'] = (ui['row'] + 1) % len(items)
            elif key in (curses.KEY_LEFT, curses.KEY_RIGHT, ord('h'), ord('l'), 9):
                ui['tab'] = (ui['tab'] + 1) % len(PLANS)
                ui['row'] = min(ui['row'], len(rows()) - 1)
            elif key == ord(' '):
                item = items[ui['row']]
                if item == 'progress':
                    ui['progress'] = not ui['progress']
                else:
                    chosen[plan] ^= {item}
            elif key == ord('d'):
                chosen[plan] = set(DEFAULTS[plan])
            elif key == ord('p'):
                ui['plan'] = plan_modes[(plan_modes.index(ui['plan']) + 1) % len(plan_modes)] if ui['plan'] in plan_modes else 'auto'
            elif key in (10, 13, curses.KEY_ENTER):
                return True
            elif key in (ord('q'), 27):
                return False

    if not curses.wrapper(loop):
        print('취소했습니다.')
        return
    cfg['plan'] = ui['plan']
    cfg['progress'] = ui['progress']
    cfg['elements'] = {p: [k for k in available(p) if k in chosen[p]] for p in PLANS}
    save_config(cfg)
    print(f'저장했습니다: {CONFIG_FILE}')
    print_preview(cfg, PLANS)

def parse_args(argv):
    import argparse
    parser = argparse.ArgumentParser(
        prog='claude-status',
        description='Claude Code status line. 인자 없이 실행하면 stdin의 세션 JSON으로 한 줄을 출력합니다.')
    parser.add_argument('--no-progress', action='store_true', help='OSC 9;4 진행바를 출력하지 않음')
    parser.add_argument('--config', action='store_true', help='요소 켜고 끄기 (인터랙티브)')
    parser.add_argument('--list', action='store_true', help='요소 목록과 플랜별 켜짐 상태')
    parser.add_argument('--enable', nargs='+', metavar='KEY', help='요소 켜기 (쉼표로 여러 개)')
    parser.add_argument('--disable', nargs='+', metavar='KEY', help='요소 끄기 (쉼표로 여러 개)')
    parser.add_argument('--plan', choices=PLANS, help='--enable/--disable/--preview 대상 플랜 (기본: 지금 플랜)')
    parser.add_argument('--set-plan', choices=('auto',) + PLANS, help='플랜 감지를 고정하거나 auto로 되돌림')
    parser.add_argument('--preview', action='store_true', help='예시 데이터로 플랜별 미리보기')
    args = parser.parse_args(argv)
    for name in ('enable', 'disable'):
        values = getattr(args, name)
        if values:
            setattr(args, name, [k.strip() for v in values for k in v.split(',') if k.strip()])
    return args

def main():
    args = parse_args(sys.argv[1:]) if len(sys.argv) > 1 else None
    cfg = load_config()

    if args and (args.config or args.list or args.enable or args.disable or args.set_plan or args.preview):
        if args.set_plan:
            cfg['plan'] = args.set_plan
            save_config(cfg)
            print(f'플랜 감지: {describe_plan(cfg)[1]}')
        plan = args.plan or describe_plan(cfg)[0]
        if args.enable:
            edit_elements(cfg, plan, args.enable, True)
        if args.disable:
            edit_elements(cfg, plan, args.disable, False)
        if args.list:
            print_list(cfg)
        if args.preview:
            print_preview(cfg, [args.plan] if args.plan else PLANS)
        if args.config:
            if not sys.stdin.isatty():
                sys.exit('--config는 터미널에서 실행하세요.')
            run_config_ui(cfg)
        return

    payload = {}
    if not sys.stdin.isatty():
        try:
            payload = json.loads(sys.stdin.read() or '{}')
        except ValueError:
            payload = {}
        if not isinstance(payload, dict):
            payload = {}

    status = build_status(payload, cfg)
    print(status.render())

    if cfg.get('progress', True) and not (args and args.no_progress):
        emit_progress(status.percent_used())

main()
